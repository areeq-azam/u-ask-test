{
  "name": "u-ask-test",
  "version": "1.0.0",
  "description": "Playwright automation for u-ask website testing",
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "postinstall": "playwright install",
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:all": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:headed": "playwright test --headed",
    "test:headless": "playwright test",
    "test:sequential": "playwright test --workers=1",
    "test:parallel": "playwright test",
    "test:debug": "playwright test --debug",
    "test:chatbot": "playwright test tests/chatbot.test.js",
    "test:chatbot:headed": "playwright test tests/chatbot.test.js --headed",
    "test:chatbot:sequential": "playwright test tests/chatbot.test.js --workers=1",
    "test:ai-validation": "playwright test tests/ai-validation-chatbot.test.js",
    "test:ai-validation:headed": "playwright test tests/ai-validation-chatbot.test.js --headed",
    "test:ai-validation:sequential": "playwright test tests/ai-validation-chatbot.test.js --workers=1",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "openai": "^4.104.0"
  }
}
